{
  "name": "atscript-ui",
  "version": "0.1.57",
  "private": true,
  "description": "Monorepo for automated forms and smart tables driven by atscript type metadata",
  "homepage": "https://github.com/moostjs/atscript-ui#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git"
  },
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "dev": "pnpm --filter @atscript/vue-demo run dev",
    "demo:dev": "pnpm --filter @atscript/vue-demo run dev",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "build": "vp run build -r",
    "test": "vp run test -r",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@atscript/db",
      "@atscript/db-client",
      "@atscript/db-sqlite",
      "@atscript/moost-db",
      "@swc/core",
      "better-sqlite3"
    ]
  }
}
