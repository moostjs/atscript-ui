{
  "name": "@atscript/ui-table",
  "version": "0.1.72",
  "description": "Framework-agnostic filter model, filter-to-Uniquery conversion, and preset serialization for atscript tables",
  "keywords": [
    "atscript",
    "table",
    "filters",
    "uniquery",
    "preset",
    "metadata",
    "type-driven",
    "typescript"
  ],
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "license": "MIT",
  "homepage": "https://github.com/moostjs/atscript-ui/tree/main/packages/ui-table#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git",
    "directory": "packages/ui-table"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@atscript/ui": "workspace:*"
  },
  "devDependencies": {
    "@atscript/db-client": "catalog:",
    "@uniqu/core": "catalog:",
    "@uniqu/url": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@atscript/db-client": "catalog:",
    "@uniqu/core": "catalog:",
    "@uniqu/url": "catalog:"
  }
}
