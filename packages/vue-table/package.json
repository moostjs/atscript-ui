{
  "name": "@atscript/vue-table",
  "version": "0.1.99",
  "description": "Type-driven table components for Atscript with Vue 3",
  "keywords": [
    "atscript",
    "components",
    "datatable",
    "filters",
    "metadata",
    "table",
    "type-driven",
    "typescript",
    "virtualized",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/moostjs/atscript-ui/tree/main/packages/vue-table#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git",
    "directory": "packages/vue-table"
  },
  "files": [
    "dist",
    "styles.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./as-action-form-dialog": {
      "types": "./dist/as-action-form-dialog.d.mts",
      "import": "./dist/as-action-form-dialog.mjs",
      "require": "./dist/as-action-form-dialog.cjs"
    },
    "./as-cell-array": {
      "types": "./dist/as-cell-array.d.mts",
      "import": "./dist/as-cell-array.mjs",
      "require": "./dist/as-cell-array.cjs"
    },
    "./as-cell-date": {
      "types": "./dist/as-cell-date.d.mts",
      "import": "./dist/as-cell-date.mjs",
      "require": "./dist/as-cell-date.cjs"
    },
    "./as-cell-json": {
      "types": "./dist/as-cell-json.d.mts",
      "import": "./dist/as-cell-json.mjs",
      "require": "./dist/as-cell-json.cjs"
    },
    "./as-cell-number": {
      "types": "./dist/as-cell-number.d.mts",
      "import": "./dist/as-cell-number.mjs",
      "require": "./dist/as-cell-number.cjs"
    },
    "./as-cell-union": {
      "types": "./dist/as-cell-union.d.mts",
      "import": "./dist/as-cell-union.mjs",
      "require": "./dist/as-cell-union.cjs"
    },
    "./as-column-menu": {
      "types": "./dist/as-column-menu.d.mts",
      "import": "./dist/as-column-menu.mjs",
      "require": "./dist/as-column-menu.cjs"
    },
    "./as-config-dialog": {
      "types": "./dist/as-config-dialog.d.mts",
      "import": "./dist/as-config-dialog.mjs",
      "require": "./dist/as-config-dialog.cjs"
    },
    "./as-confirm-dialog": {
      "types": "./dist/as-confirm-dialog.d.mts",
      "import": "./dist/as-confirm-dialog.mjs",
      "require": "./dist/as-confirm-dialog.cjs"
    },
    "./as-filter-dialog": {
      "types": "./dist/as-filter-dialog.d.mts",
      "import": "./dist/as-filter-dialog.mjs",
      "require": "./dist/as-filter-dialog.cjs"
    },
    "./as-filter-field": {
      "types": "./dist/as-filter-field.d.mts",
      "import": "./dist/as-filter-field.mjs",
      "require": "./dist/as-filter-field.cjs"
    },
    "./as-filter-input": {
      "types": "./dist/as-filter-input.d.mts",
      "import": "./dist/as-filter-input.mjs",
      "require": "./dist/as-filter-input.cjs"
    },
    "./as-filters": {
      "types": "./dist/as-filters.d.mts",
      "import": "./dist/as-filters.mjs",
      "require": "./dist/as-filters.cjs"
    },
    "./as-preset-dialog": {
      "types": "./dist/as-preset-dialog.d.mts",
      "import": "./dist/as-preset-dialog.mjs",
      "require": "./dist/as-preset-dialog.cjs"
    },
    "./as-preset-picker": {
      "types": "./dist/as-preset-picker.d.mts",
      "import": "./dist/as-preset-picker.mjs",
      "require": "./dist/as-preset-picker.cjs"
    },
    "./as-row-actions": {
      "types": "./dist/as-row-actions.d.mts",
      "import": "./dist/as-row-actions.mjs",
      "require": "./dist/as-row-actions.cjs"
    },
    "./as-table": {
      "types": "./dist/as-table.d.mts",
      "import": "./dist/as-table.mjs",
      "require": "./dist/as-table.cjs"
    },
    "./as-table-actions": {
      "types": "./dist/as-table-actions.d.mts",
      "import": "./dist/as-table-actions.mjs",
      "require": "./dist/as-table-actions.cjs"
    },
    "./as-table-cell-value": {
      "types": "./dist/as-table-cell-value.d.mts",
      "import": "./dist/as-table-cell-value.mjs",
      "require": "./dist/as-table-cell-value.cjs"
    },
    "./as-table-header-cell": {
      "types": "./dist/as-table-header-cell.d.mts",
      "import": "./dist/as-table-header-cell.mjs",
      "require": "./dist/as-table-header-cell.cjs"
    },
    "./as-table-root": {
      "types": "./dist/as-table-root.d.mts",
      "import": "./dist/as-table-root.mjs",
      "require": "./dist/as-table-root.cjs"
    },
    "./as-window-table": {
      "types": "./dist/as-window-table.d.mts",
      "import": "./dist/as-window-table.mjs",
      "require": "./dist/as-window-table.cjs"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/gen-exports.mjs && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@atscript/ui": "workspace:^",
    "@atscript/ui-table": "workspace:^",
    "@atscript/vue-form": "workspace:^"
  },
  "devDependencies": {
    "@atscript/db-client": "catalog:",
    "@atscript/typescript": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "@uniqu/core": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "happy-dom": "catalog:",
    "reka-ui": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "vunor": "catalog:"
  },
  "peerDependencies": {
    "@atscript/db-client": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "@vueuse/core": "catalog:",
    "reka-ui": "catalog:",
    "vue": "catalog:"
  }
}
