exports[`built-in English texts are unchanged > filter bar chips: residual filter, temporal and boolean conditions 1`] = `
"<!-- Multi-root fragment on purpose: the fields (and the overflow trigger)
       are direct children of whatever toolbar row the host wraps this in,
       so this component adds no box and no layout of its own. -->
<div class="as-filter-field"><label for="v-0" class="as-filter-field-label">Created</label>
  <div class="as-filter-field-body"><!-- Plain input (no dropdown) -->
    <div class="as-filter-field-input"><div class="as-filter-field-chips"><span class="as-filter-field-chip">Last 7 days <span class="as-filter-field-chip-remove" role="button" tabindex="-1">×</span></span><span class="as-filter-field-chip">before 2 months ago <span class="as-filter-field-chip-remove" role="button" tabindex="-1">×</span></span></div><input id="v-0" class="as-filter-field-search" placeholder="YYYY-MM-DD" value=""></div>
    <!-- \`tabindex="-1"\`: don't compete with the field's own input for tab
           order — Tab moves cleanly between filter fields, F4 on the input
           opens this dialog. Button stays click-target for mouse users. --><button type="button" class="as-filter-field-f4" tabindex="-1" aria-label="Open filter dialog (F4)" title="Open filter dialog (F4)"><span class="i-as-value-help" aria-hidden="true"></span></button></div></div>
<div class="as-filter-field"><label for="v-1" class="as-filter-field-label">Flag</label>
  <div class="as-filter-field-body"><div dir="ltr" class="as-filter-field-input"><div class="as-filter-field-chips"><span class="as-filter-field-chip">Yes <span class="as-filter-field-chip-remove" role="button" tabindex="-1"><span class="i-as-close" aria-hidden="true"></span></span></span></div><input aria-disabled="false" type="text" aria-expanded="false" aria-controls="reka-combobox-content-v-2" aria-autocomplete="list" role="combobox" autocomplete="off" id="v-1" class="as-filter-field-search" value=""></div>
    <!---->
    <!--v-if-->
    <!-- \`tabindex="-1"\`: don't compete with the field's own input for tab
           order — Tab moves cleanly between filter fields, F4 on the input
           opens this dialog. Button stays click-target for mouse users. --><button type="button" class="as-filter-field-f4" tabindex="-1" aria-label="Open filter dialog (F4)" title="Open filter dialog (F4)"><span class="i-as-value-help" aria-hidden="true"></span></button></div></div>
<div class="as-filter-field"><label for="v-3" class="as-filter-field-label">Name</label>
  <div class="as-filter-field-body"><!-- Plain input (no dropdown) -->
    <div class="as-filter-field-input"><div class="as-filter-field-chips"></div><input id="v-3" class="as-filter-field-search" value=""></div>
    <!-- \`tabindex="-1"\`: don't compete with the field's own input for tab
           order — Tab moves cleanly between filter fields, F4 on the input
           opens this dialog. Button stays click-target for mouse users. --><button type="button" class="as-filter-field-f4" tabindex="-1" aria-label="Open filter dialog (F4)" title="Open filter dialog (F4)"><span class="i-as-value-help" aria-hidden="true"></span></button></div></div>
<div class="as-residual-filter" title="Name: empty"><span class="as-residual-filter-label">Custom filter</span><span class="as-residual-filter-text">Name: empty</span><button type="button" class="as-residual-filter-remove" aria-label="Remove custom filter"><span class="i-as-close" aria-hidden="true"></span></button></div>
<div class="as-residual-filter" title="Name equals a or Name is one of b, c"><span class="as-residual-filter-label">Custom filter</span><span class="as-residual-filter-text">Name equals a or Name is one of b, c</span><button type="button" class="as-residual-filter-remove" aria-label="Remove custom filter"><span class="i-as-close" aria-hidden="true"></span></button></div>
<!--v-if-->"
`;

