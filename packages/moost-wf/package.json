{
  "name": "@atscript/moost-wf",
  "version": "0.1.119",
  "description": "Workflow form integration for moost — decorators, interceptors, and serialization driven by atscript type metadata",
  "keywords": [
    "atscript",
    "decorators",
    "interceptors",
    "metadata",
    "moost",
    "type-driven",
    "typescript",
    "wf",
    "workflow"
  ],
  "homepage": "https://github.com/moostjs/atscript-ui/tree/main/packages/moost-wf#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git",
    "directory": "packages/moost-wf"
  },
  "files": [
    "dist",
    "src/store/as-wf-state.as",
    "src/store/as-wf-state.as.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./store": {
      "types": "./dist/store.d.mts",
      "import": "./dist/store.mjs"
    },
    "./store.as": {
      "types": "./src/store/as-wf-state.as.d.ts",
      "default": "./src/store/as-wf-state.as"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/db": "catalog:",
    "@atscript/db-sqlite": "catalog:",
    "@atscript/typescript": "catalog:",
    "@atscript/ui": "workspace:^",
    "@moostjs/event-wf": "catalog:",
    "@prostojs/wf": "^0.1.1",
    "@wooksjs/event-core": "catalog:",
    "@wooksjs/event-wf": "catalog:",
    "moost": "catalog:",
    "unplugin-atscript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/typescript": "catalog:",
    "@moostjs/event-wf": "catalog:",
    "@wooksjs/event-core": "catalog:",
    "@wooksjs/event-wf": "catalog:",
    "moost": "catalog:"
  }
}
