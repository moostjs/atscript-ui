{
  "name": "@atscript/vue-wf",
  "version": "0.1.107",
  "description": "Workflow form integration for Vue 3 — HTTP round-trip loop driven by atscript type metadata",
  "keywords": [
    "atscript",
    "form",
    "metadata",
    "moost",
    "type-driven",
    "typescript",
    "vue",
    "vue3",
    "wf",
    "workflow"
  ],
  "homepage": "https://github.com/moostjs/atscript-ui/tree/main/packages/vue-wf#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git",
    "directory": "packages/vue-wf"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./as-wf-finish": {
      "types": "./dist/as-wf-finish.d.mts",
      "import": "./dist/as-wf-finish.mjs"
    },
    "./as-wf-form": {
      "types": "./dist/as-wf-form.d.mts",
      "import": "./dist/as-wf-form.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/gen-exports.mjs && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@atscript/ui": "workspace:^"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/moost-wf": "workspace:^",
    "@atscript/typescript": "catalog:",
    "@atscript/vue-form": "workspace:^",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "unplugin-atscript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@atscript/typescript": "catalog:",
    "@atscript/vue-form": "workspace:^",
    "vue": "catalog:"
  }
}
