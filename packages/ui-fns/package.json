{
  "name": "@atscript/ui-fns",
  "version": "0.1.131",
  "description": "Dynamic fn-compiled field properties for @atscript/ui (opt-in, uses new Function)",
  "keywords": [
    "annotations",
    "atscript",
    "dynamic",
    "expressions",
    "form",
    "metadata",
    "type-driven",
    "typescript"
  ],
  "homepage": "https://github.com/moostjs/atscript-ui/tree/main/packages/ui-fns#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git",
    "directory": "packages/ui-fns"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@atscript/ui": "workspace:^",
    "@prostojs/deserialize-fn": "^0.0.5"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/typescript": "catalog:"
  }
}
