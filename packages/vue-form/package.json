{
  "name": "@atscript/vue-form",
  "version": "0.1.107",
  "description": "Type-driven form rendering for Atscript with Vue 3",
  "keywords": [
    "atscript",
    "components",
    "form",
    "form-builder",
    "metadata",
    "type-driven",
    "typescript",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/moostjs/atscript-ui/tree/main/packages/vue-form#readme",
  "bugs": {
    "url": "https://github.com/moostjs/atscript-ui/issues"
  },
  "license": "MIT",
  "author": "Artem Maltsev <artem@maltsev.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moostjs/atscript-ui.git",
    "directory": "packages/vue-form"
  },
  "files": [
    "dist",
    "styles.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./as-action": {
      "types": "./dist/as-action.d.mts",
      "import": "./dist/as-action.mjs",
      "require": "./dist/as-action.cjs"
    },
    "./as-array": {
      "types": "./dist/as-array.d.mts",
      "import": "./dist/as-array.mjs",
      "require": "./dist/as-array.cjs"
    },
    "./as-checkbox": {
      "types": "./dist/as-checkbox.d.mts",
      "import": "./dist/as-checkbox.mjs",
      "require": "./dist/as-checkbox.cjs"
    },
    "./as-collapsible": {
      "types": "./dist/as-collapsible.d.mts",
      "import": "./dist/as-collapsible.mjs",
      "require": "./dist/as-collapsible.cjs"
    },
    "./as-date": {
      "types": "./dist/as-date.d.mts",
      "import": "./dist/as-date.mjs",
      "require": "./dist/as-date.cjs"
    },
    "./as-datetime": {
      "types": "./dist/as-datetime.d.mts",
      "import": "./dist/as-datetime.mjs",
      "require": "./dist/as-datetime.cjs"
    },
    "./as-decimal": {
      "types": "./dist/as-decimal.d.mts",
      "import": "./dist/as-decimal.mjs",
      "require": "./dist/as-decimal.cjs"
    },
    "./as-field": {
      "types": "./dist/as-field.d.mts",
      "import": "./dist/as-field.mjs",
      "require": "./dist/as-field.cjs"
    },
    "./as-field-shell": {
      "types": "./dist/as-field-shell.d.mts",
      "import": "./dist/as-field-shell.mjs",
      "require": "./dist/as-field-shell.cjs"
    },
    "./as-form": {
      "types": "./dist/as-form.d.mts",
      "import": "./dist/as-form.mjs",
      "require": "./dist/as-form.cjs"
    },
    "./as-input": {
      "types": "./dist/as-input.d.mts",
      "import": "./dist/as-input.mjs",
      "require": "./dist/as-input.cjs"
    },
    "./as-iterator": {
      "types": "./dist/as-iterator.d.mts",
      "import": "./dist/as-iterator.mjs",
      "require": "./dist/as-iterator.cjs"
    },
    "./as-multi-select": {
      "types": "./dist/as-multi-select.d.mts",
      "import": "./dist/as-multi-select.mjs",
      "require": "./dist/as-multi-select.cjs"
    },
    "./as-number": {
      "types": "./dist/as-number.d.mts",
      "import": "./dist/as-number.mjs",
      "require": "./dist/as-number.cjs"
    },
    "./as-object": {
      "types": "./dist/as-object.d.mts",
      "import": "./dist/as-object.mjs",
      "require": "./dist/as-object.cjs"
    },
    "./as-paragraph": {
      "types": "./dist/as-paragraph.d.mts",
      "import": "./dist/as-paragraph.mjs",
      "require": "./dist/as-paragraph.cjs"
    },
    "./as-radio": {
      "types": "./dist/as-radio.d.mts",
      "import": "./dist/as-radio.mjs",
      "require": "./dist/as-radio.cjs"
    },
    "./as-ref": {
      "types": "./dist/as-ref.d.mts",
      "import": "./dist/as-ref.mjs",
      "require": "./dist/as-ref.cjs"
    },
    "./as-select": {
      "types": "./dist/as-select.d.mts",
      "import": "./dist/as-select.mjs",
      "require": "./dist/as-select.cjs"
    },
    "./as-time": {
      "types": "./dist/as-time.d.mts",
      "import": "./dist/as-time.mjs",
      "require": "./dist/as-time.cjs"
    },
    "./as-tuple": {
      "types": "./dist/as-tuple.d.mts",
      "import": "./dist/as-tuple.mjs",
      "require": "./dist/as-tuple.cjs"
    },
    "./as-union": {
      "types": "./dist/as-union.d.mts",
      "import": "./dist/as-union.mjs",
      "require": "./dist/as-union.cjs"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/gen-exports.mjs && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@atscript/ui": "workspace:^"
  },
  "devDependencies": {
    "@atscript/core": "catalog:",
    "@atscript/db-client": "catalog:",
    "@atscript/typescript": "catalog:",
    "@atscript/ui-fns": "workspace:^",
    "@tsdown/css": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "reka-ui": "catalog:",
    "unplugin-atscript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "vunor": "catalog:"
  },
  "peerDependencies": {
    "@atscript/db-client": "catalog:",
    "@atscript/ui-fns": "workspace:^",
    "reka-ui": "catalog:",
    "vue": "catalog:"
  }
}
