"<form class="as-form"><!--v-if-->
  <!--v-if-->
  <!-- Root grid renders the above-submit partition; \`@ui.form.pushDown\`
         fields go to AsForm's below-submit grid via \`def.pushDownFields\`. -->
  <div class="as-form-grid as-grid-item"><div class="as-default-field as-checkbox-field as-grid-item"><!-- Header row: label/header on left, action buttons on right -->
      <!--v-if-->
      <!--v-if-->
      <div class="as-field-input-row"><div class="as-checkbox-row"><span id="as-field-v-1-label" class="as-field-label">yes</span><span id="as-field-v-1" class="as-checkbox-value" role="group" aria-labelledby="as-field-v-1-label">Yes</span><!-- Treat both undefined and null as 'unset' — DB-roundtripped null otherwise renders as "set". -->
          <!--v-if--></div></div>
