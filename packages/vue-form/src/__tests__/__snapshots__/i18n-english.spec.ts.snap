exports[`built-in English texts are unchanged > the dirty status 1`] = `
"<form class="as-form"><!--v-if-->
  <!--v-if-->
  <!-- Root grid renders the above-submit partition; \`@ui.form.pushDown\`
         fields go to AsForm's below-submit grid via \`def.pushDownFields\`. -->
  <div class="as-form-grid as-grid-item"><div class="as-default-field as-grid-item" data-dirty=""><!-- Header row: label/header on left, action buttons on right -->
      <div class="as-field-header-row"><div class="as-field-header-content"><label for="as-field-v-1" class="as-field-label">Name
            <!--v-if--></label><!-- Union variant picker — inline next to label -->
          <!--v-if--></div>
        <!--v-if--></div>
      <!--v-if-->
      <div class="as-field-input-row"><input id="as-field-v-1" name="name" type="text" aria-describedby="as-field-v-1-status"></div>
      <div class="as-field-footer-row"><!-- \`status\` owns the whole error/hint/announcement area: overriding it
             replaces the default markup wholesale (keep \`statusId\` on your own
             node so \`aria-describedby\` still resolves). --><span class="as-error-slot" aria-hidden="true"></span>
        <!-- Visually hidden: the \`data-dirty\` rail is the sighted cue, this
               is its AT counterpart. \`role="status"\` would make it a live
               region and re-announce on every keystroke — it is referenced
               through \`aria-describedby\` instead, which AsField appends on
               exactly this \`isDirty\` condition, so a clean field never points
               at a missing node. --><span id="as-field-v-1-status" class="as-field-status">Modified</span>
        <!--v-if--></div></div>
    <div class="as-default-field as-grid-item"><!-- Header row: label/header on left, action buttons on right -->
      <div class="as-field-header-row"><div class="as-field-header-content"><label for="as-field-v-2" class="as-field-label">Age
            <!--v-if--></label><!-- Union variant picker — inline next to label -->
          <!--v-if--></div>
        <div class="as-field-header-actions"><button type="button" class="as-field-remove-btn" aria-label="Unset value" title="Unset"><span class="as-field-remove-btn-icon" aria-hidden="true"></span></button></div></div>
      <!--v-if-->
      <div class="as-field-input-row"><!-- Adornment path: bordered shell with prefix / suffix pills. The
           shell paints whenever AsField saw an adornment-driving
           annotation on the field — even when the resolved prefix/suffix
           is currently empty (sibling-ref source not selected yet),
           keeping the layout stable. -->
        <!-- Plain-number fallback: defer to AsInputControl (visually unchanged
           from the pre-Phase-6 single <input type="number">rendering). --><input id="as-field-v-2" name="age" type="number"></div>
      <!--v-if--></div></div>
  <!--v-if--><button type="submit" class="as-submit-btn">Submit</button><!-- \`@ui.form.pushDown\` fields render in their own grid below submit. -->
  <!--v-if-->
  <!--v-if--></form>"
`;

exports[`built-in English texts are unchanged > unions and tuples: variant picker, add, unset 1`] = `
"<form class="as-form"><!--v-if-->
  <!--v-if-->
  <!-- Root grid renders the above-submit partition; \`@ui.form.pushDown\`
         fields go to AsForm's below-submit grid via \`def.pushDownFields\`. -->
  <div class="as-form-grid as-grid-item"><!-- Active: dispatch to variant's component, forwarding the field's @meta.label
       as title so the variant's chrome shows it (innerField.type overrides "union"). -->
    <details class="as-collapsible-section as-grid-item as-grid-item" data-object-level="1"><summary class="as-collapsible-summary"><div class="as-collapsible-header"><div class="as-collapsible-title-row"><h3 class="as-collapsible-title">Primary contact
              <!--v-if--></h3>
            <div class="as-dropdown"><button type="button" class="as-variant-trigger" title="Switch type — current: Email contact">Email contact</button>
              <!--v-if--></div></div>
          <p class="as-collapsible-description">Required object union of three variants.</p></div>
        <!--v-if--><span class="as-collapsible-chevron as-collapsible-chevron-collapsed" aria-hidden="true"></span></summary>
      <div class="as-collapsible-body"><!--v-if-->
        <div class="as-default-field as-grid-item required"><!-- Header row: label/header on left, action buttons on right -->
          <div class="as-field-header-row"><div class="as-field-header-content"><label for="as-field-v-2" class="as-field-label">Email
