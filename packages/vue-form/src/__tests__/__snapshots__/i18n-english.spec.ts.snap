exports[`built-in English texts are unchanged > arrays: add / remove / clear 1`] = `
"<form class="as-form"><!--v-if-->
  <!--v-if-->
  <!-- Root grid renders the above-submit partition; \`@ui.form.pushDown\`
         fields go to AsForm's below-submit grid via \`def.pushDownFields\`. -->
  <div class="as-form-grid as-grid-item"><details class="as-collapsible-section as-grid-item as-grid-item" data-object-level="1" open=""><summary class="as-collapsible-summary"><div class="as-collapsible-header"><div class="as-collapsible-title-row"><h3 class="as-collapsible-title">Items
              <!--v-if--></h3></div>
          <!--v-if--></div><span class="as-array-items-chip">1 items</span>
        <!-- Hide Clear only when required+empty: optional arrays keep it
           so the user can collapse back to undefined. --><button type="button" class="as-optional-clear" aria-label="Clear items">Clear</button>
        <!--v-if--><span class="as-collapsible-chevron" aria-hidden="true"></span></summary>
      <div class="as-collapsible-body"><!--v-if-->
        <details class="as-collapsible-island as-collapsible-island-even as-grid-item as-grid-item" data-object-level="2" open=""><summary class="as-collapsible-summary"><div class="as-collapsible-header"><div class="as-collapsible-title-row"><h4 class="as-collapsible-title-nested">Item<span class="as-collapsible-title-index">&nbsp;#1</span></h4></div>
              <!--v-if--></div><button type="button" class="as-field-remove-btn" disabled="" aria-label="Remove" title="Remove"><span class="as-field-remove-btn-icon" aria-hidden="true"></span></button>
            <!--v-if--><span class="as-collapsible-chevron" aria-hidden="true"></span></summary>
          <div class="as-collapsible-body"><!--v-if-->
            <div class="as-default-field as-grid-item"><!-- Header row: label/header on left, action buttons on right -->
              <div class="as-field-header-row"><div class="as-field-header-content"><label for="as-field-v-3" class="as-field-label">Label
                    <!--v-if--></label><!-- Union variant picker — inline next to label -->
                  <!--v-if--></div>
                <!--v-if--></div>
              <!--v-if-->
              <div class="as-field-input-row"><input id="as-field-v-3" name="label" type="text"></div>
              <!--v-if--></div>
            <div class="as-default-field as-grid-item"><!-- Header row: label/header on left, action buttons on right -->
              <div class="as-field-header-row"><div class="as-field-header-content"><label for="as-field-v-4" class="as-field-label">Number
                    <!--v-if--></label><!-- Union variant picker — inline next to label -->
                  <!--v-if--></div>
                <!--v-if--></div>
              <!--v-if-->
              <div class="as-field-input-row"><input id="as-field-v-4" name="number" type="text"></div>
              <!--v-if--></div></div></details>
        <div class="as-array-add-row"><button type="button" class="as-array-add-btn">Add item</button></div></div></details></div>
  <!--v-if--><button type="submit" class="as-submit-btn">Submit</button><!-- \`@ui.form.pushDown\` fields render in their own grid below submit. -->
  <!--v-if-->
  <!--v-if--></form>"
`;

