          <!--v-if-->
          <!--v-if-->
          <div class="as-field-input-row"><div class="as-checkbox-row"><label for="as-field-v-3" class="as-field-label as-checkbox-indeterminate"><input id="as-field-v-3" type="checkbox" name="newsletter">newsletter</label><!-- Treat both undefined and null as 'unset' — DB-roundtripped null otherwise renders as "set". -->
              <!--v-if--></div></div>
          <!--v-if--></div></div></details></div>
  <!--v-if--><button type="submit" class="as-submit-btn">Submit</button><!-- \`@ui.form.pushDown\` fields render in their own grid below submit. -->
  <!--v-if-->
  <!--v-if--></form>"
`;

